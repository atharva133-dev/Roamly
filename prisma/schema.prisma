generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  TRANSPORT
  FOOD
  HOTEL
  ACTIVITIES
  CONTINGENCY
}

enum UserRole {
  USER
  GUIDE
  SUPER_ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  COMPLETED
}

model User {
  user_id           String   @id @default(cuid())
  clerk_id          String?  @unique
  email             String   @unique
  password_hash     String?
  full_name         String?
  role              UserRole @default(USER)
  profile_completed Boolean  @default(false)
  profile_photo_url String?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  userProfile  UserProfile?
  guideProfile GuideProfile?

  trips        Trip[]
  reviews      Review[]
  sentRequests GuideRequest[] @relation("UserGuideRequests")

  @@map("users")
}

model UserProfile {
  id              String   @id @default(cuid())
  user_id         String   @unique
  user            User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  phone           String?
  city            String?
  country         String?
  travel_style    String? // relaxed, adventure, cultural, etc.
  budget_currency String   @default("INR")
  custom_budget   Float? // Exact budget entered by user
  budget_tier     String? // backpacker, budget, mid-range, luxury
  interests       String[]
  dietary_needs   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("user_profiles")
}

model GuideProfile {
  id                   String             @id @default(cuid())
  user_id              String             @unique
  user                 User               @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  phone                String?
  bio                  String?
  profile_photo        String?
  languages            String[]
  expertise            String[]
  experience_years     Int                @default(0)
  hourly_rate          Float?             @default(500)
  currency             String             @default("INR")
  available_days       String[]           // e.g. ["Monday", "Tuesday", ...]
  available_time_from  String?            // e.g. "09:00"
  available_time_to    String?            // e.g. "18:00"
  verification_status  VerificationStatus @default(PENDING)
  availability_status  AvailabilityStatus @default(OFFLINE)
  current_location_id  String?
  current_location     Location?          @relation("GuideCurrentLocation", fields: [current_location_id], references: [id])
  last_location_update DateTime?
  email_verified_at             DateTime?
  verification_token_hash       String?
  verification_token_expires_at DateTime?
  verification_token_used_at    DateTime?
  created_at                    DateTime           @default(now())
  updated_at                    DateTime           @updatedAt

  locations GuideLocation[]
  requests  GuideRequest[]  @relation("GuideReceivedRequests")
  selectedInTrips Trip[]    @relation("TripSelectedGuide")

  @@index([verification_status, availability_status])
  @@index([verification_token_hash])
  @@map("guide_profiles")
}

model Location {
  id                String   @id @default(cuid())
  name              String // e.g. "Gateway of India", "Colaba"
  city              String // e.g. "Mumbai"
  state             String?
  country           String   @default("India")
  postal_code       String?
  place_id          String? // Google Maps placeId (legacy)
  google_place_id   String?  @unique // Google Maps placeId (canonical)
  formatted_address String?
  latitude          Float?
  longitude         Float?
  type              String? // monument, market, beach, temple, museum, city, attraction
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  guideLocations GuideLocation[]
  currentGuides  GuideProfile[]  @relation("GuideCurrentLocation")
  guideRequests  GuideRequest[]
  stops          Stop[]

  @@index([city, is_active])
  @@index([google_place_id])
  @@map("locations")
}

model GuideLocation {
  id             String       @id @default(cuid())
  guide_id       String
  guide          GuideProfile @relation(fields: [guide_id], references: [id], onDelete: Cascade)
  location_id    String
  location       Location     @relation(fields: [location_id], references: [id], onDelete: Cascade)
  is_active      Boolean      @default(true)
  available_from String? // e.g. "09:00"
  available_to   String? // e.g. "18:00"
  created_at     DateTime     @default(now())

  @@unique([guide_id, location_id])
  @@index([location_id, is_active])
  @@map("guide_locations")
}

model GuideRequest {
  id          String        @id @default(cuid())
  user_id     String
  user        User          @relation("UserGuideRequests", fields: [user_id], references: [user_id], onDelete: Cascade)
  guide_id    String
  guide       GuideProfile  @relation("GuideReceivedRequests", fields: [guide_id], references: [id], onDelete: Cascade)
  location_id String
  location    Location      @relation(fields: [location_id], references: [id])
  tour_id     Int?
  tour        Trip?         @relation(fields: [tour_id], references: [trip_id], onDelete: SetNull)
  date        DateTime
  start_time  String // e.g. "10:00 AM"
  duration    Int // in hours
  message     String?
  total_cost  Float?
  status      RequestStatus @default(PENDING)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt

  @@index([guide_id, status])
  @@index([user_id])
  @@map("guide_requests")
}

model Admin {
  admin_id   Int     @id @default(autoincrement())
  email      String  @unique
  password   String
  top_cities String?
  city_id    Int?
  city       City?   @relation(fields: [city_id], references: [city_id])

  trips Trip[] @relation("AdminTrips")

  @@map("admin")
}

model City {
  city_id     Int     @id @default(autoincrement())
  country     String?
  state       String?
  city        String
  image_url   String?
  description String?

  admins     Admin[]
  // removed trips direct link; trips connect via stops
  activities Activity[]
  stops      Stop[]

  @@index([city, state, country])
  @@map("city")
}

model Trip {
  trip_id     Int       @id @default(autoincrement())
  description String?
  start_date  DateTime?
  end_date    DateTime?

  user_id String
  user    User   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  // trip can optionally be linked to an admin (info_with)
  admin_id Int?
  admin    Admin? @relation("AdminTrips", fields: [admin_id], references: [admin_id])

  budgets       Budget[]
  stops         Stop[]
  reviews       Review[]
  guideRequests GuideRequest[]

  selected_guide_id String?
  selected_guide    GuideProfile?  @relation("TripSelectedGuide", fields: [selected_guide_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([selected_guide_id])
  @@map("trips")
}

model Budget {
  budget_id Int      @id @default(autoincrement())
  amount    Float
  trip_id   Int
  trip      Trip     @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)
  category  Category

  @@index([trip_id])
  @@map("budgets")
}

model Activity {
  activity_id Int     @id @default(autoincrement())
  name        String
  type        String
  cost        Float?
  image_url   String?
  duration    Int?

  // Activities are cataloged per city
  city_id Int
  city    City @relation(fields: [city_id], references: [city_id])

  stopActivities StopActivity[]

  @@index([city_id])
  @@map("activities")
}

model Stop {
  id Int @id @default(autoincrement())

  trip_id Int
  trip    Trip @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)

  city_id Int?
  city    City? @relation(fields: [city_id], references: [city_id])

  location_id String?
  location    Location? @relation(fields: [location_id], references: [id], onDelete: SetNull)

  // ordering and timing for multi-city itineraries
  sequence       Int
  arrival_date   DateTime?
  departure_date DateTime?

  stopActivities StopActivity[]

  @@unique([trip_id, sequence]) // one sequence position per trip
  @@index([trip_id])
  @@index([city_id])
  @@index([location_id])
  @@map("stops")
}

model StopActivity {
  id          Int @id @default(autoincrement())
  stop_id     Int
  activity_id Int

  stop     Stop     @relation(fields: [stop_id], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activity_id], references: [activity_id], onDelete: Cascade)

  @@unique([stop_id, activity_id])
  @@index([stop_id])
  @@index([activity_id])
  @@map("stop_activities")
}

model Review {
  review_id   Int      @id @default(autoincrement())
  user_id     String
  trip_id     Int
  stars       Int      @db.SmallInt
  description String
  created_at  DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  trip Trip @relation(fields: [trip_id], references: [trip_id], onDelete: Cascade)

  @@index([trip_id])
  @@index([user_id])
  @@map("reviews")
}
