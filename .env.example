GOOGLE_API_KEY=
GEMINI_API_KEY=
# Optional: override the first model tried by itineraryAgent.js.
# Fallback chain if unset/unavailable: gemini-3.8-flash -> gemini-3.7-flash -> gemini-3.5-flash -> gemini-2.5-pro
GEMINI_MODEL=
# --- Google Maps Platform ---
# Required APIs to enable in Google Cloud Console:
# 1. Geolocation API (approximate network/device location fallback)
# 2. Geocoding API (address <-> coordinate normalization)
# 3. Places API (New) (autocomplete, text search, place details)
# 4. Routes API (route matrix / distance-duration between itinerary stops)
GOOGLE_MAPS_SERVER_API_KEY=
# Public browser API key for Google Maps JavaScript API (Maps, Advanced Markers)
# Security: MUST be restricted by HTTP referrer (e.g. http://localhost:3000/*, https://yourdomain.com/*) in Google Cloud Console
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
REDIS_URL=

# --- Transactional Email (Guide Verification) ---
# Optional: If unset, emails are logged to console and internal audit store
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=euphatics@gmail.com
SMTP_PASS=
EMAIL_FROM="Roamly Verification <euphatics@gmail.com>"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Nugen Intelligence (Domain-Aligned Tourism AI Chatbot) ---
# Obtain your key from https://platform.nugen.in/
NUGEN_API_KEY=
NUGEN_API_URL=https://api.nugen.in
NUGEN_MODEL_ID=roamly-tourism-aligned-v1