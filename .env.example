GOOGLE_API_KEY=
GEMINI_API_KEY=
# Optional: override the first model tried by itineraryAgent.js.
# Fallback chain if unset/unavailable: gemini-3.8-flash -> gemini-3.7-flash -> gemini-3.5-flash -> gemini-2.5-pro
GEMINI_MODEL=
# --- Google Maps Platform ---
# Required APIs to enable in Google Cloud Console:
# 1. Geolocation API (approximate network/device location fallback)
# 2. Geocoding API (address <-> coordinate normalization)
# 3. Places API (New) (autocomplete, text search, place details)
# 4. Routes API (route matrix / distance-duration between itinerary stops)
GOOGLE_MAPS_SERVER_API_KEY=
DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
REDIS_URL=